{
  "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-go-template"],
  "printWidth": 120,
  "bracketSameLine": true,
  "htmlWhitespaceSensitivity": "css",
  "tailwindStylesheet": "assets/css/main.css",
  "overrides": [
    { "files": ["layouts/**/*.html"], "options": { "parser": "go-template" } },
    { "files": ["layouts/index.json"], "options": { "parser": "go-template" } }
  ]
}
