{
  "name": "hugo-theme-lavender",
  "version": "1.0.0",
  "description": "A sidebar-driven Hugo blog theme with light/dark palettes, built with Tailwind CSS v4 and Tabler Icons.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "npm run build:tailwind",
    "build:tailwind": "tailwindcss -i ./assets/css/src/input.css -o ./assets/css/theme.css",
    "build:selfhost": "node scripts/copy-deps.js",
    "watch": "tailwindcss -i ./assets/css/src/input.css -o ./assets/css/theme.css --watch",
    "clean": "rimraf assets/css/theme.css assets/lib static/lib"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.2.10",
    "@fontsource/maple-mono": "^5.2.6",
    "@tabler/icons-webfont": "^3.46.0",
    "@tailwindcss/cli": "^4.3.1",
    "minisearch": "^7.2.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "prettier": "^3.9.1",
    "prettier-plugin-go-template": "^0.0.15",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
