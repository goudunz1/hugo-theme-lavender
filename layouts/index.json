{{/* JSON search index generated at build time (consumed by the search page). */ -}}
{{ $entries := slice -}}
{{ $enabled := site.Params.searchEnabled | default false -}}
{{ if $enabled -}}
  {{/* Sections/top pages are skipped */ -}}
  {{ range where site.RegularPages "Section" "ne" "" -}}
    {{ $meta := partial "helpers/meta.html" . -}}
    {{/* Mirrors the card slots, yet keeps full content to power search scripts. */ -}}
    {{ $entries = $entries | append (dict
      "title" .Title
      "url" .RelPermalink
      "date" $meta.date.label
      "author" $meta.author.label
      "content" (.Plain | plainify)
      )
    -}}
  {{ end -}}
{{ end -}}
{{ $entries | jsonify -}}
